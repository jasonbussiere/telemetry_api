# Copy this file to .env and replace every placeholder before running the app.
# These five variables are required for Docker Compose.
POSTGRES_USER=telemetry_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=telemetry
JWT_SECRET_KEY=replace_with_a_long_random_secret
AGENT_PASSWORD=replace_with_a_strong_agent_password

# For running the API directly (without Docker Compose), set DATABASE_URL
# instead of the POSTGRES_* values. Example:
# DATABASE_URL=postgresql://telemetry_user:replace_with_a_strong_database_password@localhost:5432/telemetry
